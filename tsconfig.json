{
  "compilerOptions": {
    "noEmit": true,
    "target": "es6",
    "module": "nodenext",
    "strict": true,
    "importHelpers": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/example",
    "**/src/helper.ts"
  ],
}